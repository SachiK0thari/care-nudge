{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "App (rules-only, no GPU)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal"
    },
    {
      "name": "App (fine-tuned model)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/app.py",
      "console": "integratedTerminal",
      "env": { "MODEL_ID": "${workspaceFolder}/outputs/carenudge-merged" }
    },
    {
      "name": "Build dataset",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/build_dataset.py",
      "console": "integratedTerminal"
    },
    {
      "name": "Evaluate (rules only)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/evaluate.py",
      "console": "integratedTerminal"
    }
  ]
}
